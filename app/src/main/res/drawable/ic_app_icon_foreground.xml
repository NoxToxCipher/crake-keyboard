      <gradient
          android:startX="32"
          android:startY="34"
          android:endX="76"
          android:endY="77"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00F0FF" />
        <item android:offset="0.5" android:color="#FF00E5A3" />
        <item android:offset="1.0" android:color="#FF00B4D8" />
