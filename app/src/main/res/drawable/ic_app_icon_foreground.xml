      <gradient
          android:startX="24"
          android:startY="18"
          android:endX="84"
          android:endY="90"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00E5FF" />
        <item android:offset="0.5" android:color="#FF00E5A3" />
        <item android:offset="1.0" android:color="#FF38EF7D" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- High-Tech Neon Crake Wing & Flight Crest -->
  <path
      android:pathData="M 36,44 C 44,36 60,34 72,42 C 64,46 54,49 46,55 C 56,53 66,54 74,60 C 64,63 56,67 48,73 C 58,70 68,71 76,77 L 34,77 C 32,65 33,53 36,44 Z">
